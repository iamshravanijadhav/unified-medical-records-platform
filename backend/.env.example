# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Origin for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173

# Internal Hospital Exchange API Key (used between central retrieval service and demo hospital gateways)
EXCHANGE_GATEWAY_KEY=demo-exchange-gateway-key-2026

# Local Demo Mode Configuration
# Set DEMO_MODE=true to explicitly force local synthetic demo mode even if Firebase keys are present.
# When Firebase credentials below are left blank, the server automatically runs in documented Local Demo Mode.
DEMO_MODE=false
JWT_SECRET=demo-local-dev-secret-change-in-production

# Firebase Admin SDK Configuration (Optional for local demo mode; required for live Firestore & Firebase Auth)
# Never expose these server credentials in the frontend!
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional internal base URL override for hospital microservice HTTP calls (defaults to http://127.0.0.1:${PORT})
INTERNAL_API_BASE_URL=

